# Copy to a private .env.connect; never commit real values.
STILLON_CONNECT_ORIGIN=https://connect.stillon.example
STILLON_CONNECT_SECRET=
STILLON_CONNECT_RESEND_API_KEY=
STILLON_CONNECT_EMAIL_FROM=StillOn <login@mail.example.com>
STILLON_CONNECT_DATA_DIR=.stillon-connect
STILLON_CONNECT_PORT=3220
# Enable only behind a local trusted proxy that overwrites X-Real-IP.
STILLON_CONNECT_TRUST_PROXY=false
