# Isolated listener example. For shared 443/SNI deployments, map only the
# Connect names to this listener and preserve the existing applications.
# The certificate must cover connect.stillon.example AND *.connect.stillon.example.
# Provision/renew it using DNS-01 in the operator's secret boundary.
{
    admin 127.0.0.1:3225
    auto_https disable_redirects
    storage file_system /var/lib/stillon-connect-caddy/data
}

https://connect.stillon.example:18448, https://*.connect.stillon.example:18448 {
    bind 127.0.0.1
    tls /etc/stillon-connect/tls/fullchain.pem /etc/stillon-connect/tls/privkey.pem
    @tunnel {
        host connect.stillon.example
        path /~!frp
        header Upgrade websocket
    }
    handle @tunnel {
        reverse_proxy 127.0.0.1:3222
    }
    handle {
        reverse_proxy 127.0.0.1:3220 {
            header_up X-Real-IP {remote_host}
            # Public authority stays unchanged. Never forward credentials from
            # an unrelated existing personal/Feishu ingress to Connect.
        }
    }
}
