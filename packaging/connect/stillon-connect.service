[Unit]
Description=StillOn Connect accounts and authorized host gateway
After=network-online.target
Wants=network-online.target

[Service]
User=stillon-connect
Group=stillon-connect
WorkingDirectory=/opt/stillon-connect/current
EnvironmentFile=/etc/stillon-connect/connect.env
ExecStart=/opt/stillon-connect/bun src/connect/cli.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
StateDirectory=stillon-connect
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/stillon-connect
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
